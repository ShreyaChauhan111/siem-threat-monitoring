<!-- Sample custom Wazuh rules mirroring the mini SIEM detections.
     Add inside <group> blocks of /var/ossec/etc/rules/local_rules.xml, validate with wazuh-logtest,
     then restart: systemctl restart wazuh-manager. Rule IDs 100000+ are reserved for local rules. -->
<group name="local,custom_siem,">

  <!-- R001: brute force (same source, repeated failed SSH) -->
  <rule id="100101" level="10" frequency="5" timeframe="120">
    <if_matched_sid>5710</if_matched_sid>
    <same_source_ip />
    <description>Brute-force: 5+ failed SSH logins from same source in 2 minutes</description>
    <mitre><id>T1110.001</id></mitre>
  </rule>

  <!-- R002: password spray on Windows (many failed logons, same source) -->
  <rule id="100102" level="10" frequency="8" timeframe="300">
    <if_matched_sid>60122</if_matched_sid>
    <same_field>win.eventdata.ipAddress</same_field>
    <description>Password spraying: 8+ failed Windows logons from same source in 5 minutes</description>
    <mitre><id>T1110.003</id></mitre>
  </rule>

  <!-- R005: encoded / hidden PowerShell -->
  <rule id="100105" level="12">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)powershell.*(-enc|-encodedcommand|downloadstring|-w\s+hidden)</field>
    <description>Suspicious PowerShell command line (encoded or download cradle)</description>
    <mitre><id>T1059.001</id></mitre>
  </rule>

  <!-- R006: Windows security log cleared -->
  <rule id="100106" level="14">
    <field name="win.system.eventID">^1102$</field>
    <description>Windows audit log cleared</description>
    <mitre><id>T1070.001</id></mitre>
  </rule>

  <!-- R007: user added to privileged group -->
  <rule id="100107" level="12">
    <field name="win.system.eventID">^(4728|4732)$</field>
    <field name="win.eventdata.targetUserName" type="pcre2">(?i)^(domain admins|enterprise admins|administrators|schema admins)$</field>
    <description>Member added to privileged group</description>
    <mitre><id>T1098</id></mitre>
  </rule>

</group>
